BEGIN
BEGIN_PATH_INPUT
&PATH
  restart_mode      = 'from_scratch'
  string_method     = 'neb',
  nstep_path        = 50,
  ds                = 1.0D0,
  opt_scheme        = "broyden",
  num_of_images     = 5,
  path_thr          = 0.05D0,
/
END_PATH_INPUT
BEGIN_ENGINE_INPUT
&CONTROL
  prefix         = "N_diff_Al"
  outdir         = "./outdir"
  pseudo_dir     = "./"
/
&SYSTEM
  nat                    = 5,
  ntyp                   = 2,
  ibrav                  = 1,
  celldm(1)              = 7.65,
  ecutwfc                = 40,
  ecutrho                = 200,
  occupations            = "smearing",
  degauss                = 0.02,
  smearing               = 'mp'
/
&ELECTRONS
  electron_maxstep = 100
  conv_thr    = 1.D-6,
  mixing_mode = 'plain'
  mixing_beta = 0.4D0,
/
ATOMIC_SPECIES
Al  26.982 al_pbe_gbrv_1.0.upf
N   14.007 n_pbe_gbrv_1.2.upf

K_POINTS { gamma }

BEGIN_POSITIONS
FIRST_IMAGE
ATOMIC_POSITIONS (crystal)
Al   0.000000   0.000000   0.000000
Al   0.500000   0.500000   0.000000
Al   0.500000   0.000000   0.500000
Al   0.000000   0.500000   0.500000
N    0.500000   0.500000   0.200000
LAST_IMAGE
ATOMIC_POSITIONS (crystal)
Al   0.000000   0.000000   0.000000
Al   0.500000   0.500000   0.000000
Al   0.500000   0.000000   0.500000
Al   0.000000   0.500000   0.500000
N    0.500000   0.500000   0.800000
END_POSITIONS
END_ENGINE_INPUT
END
